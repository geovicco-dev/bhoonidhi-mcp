# bhoonidhi-mcp configuration. Copy to .env and edit. Never commit a filled-in
# .env. Search and saved queries need none of these; downloads and cart need a
# login (below).

# Geocoder User-Agent sent to Nominatim (required by their usage policy).
BHOONIDHI_MCP_GEOCODER_USER_AGENT=bhoonidhi-mcp/0.1

# Fuzzy satellite-name match confidence gate (0-100). Below this, the server
# returns candidate matches instead of auto-selecting.
BHOONIDHI_MCP_FUZZY_THRESHOLD=88

# Max scenes returned by a single search_scenes call (keeps agent context bounded).
BHOONIDHI_MCP_MAX_RESULTS=50

# --- Downloads ---
# Allow-listed root every download is written under, as <root>/<slug>/. The
# agent cannot choose an arbitrary path. Defaults to ~/Downloads.
# BHOONIDHI_MCP_DOWNLOAD_ROOT=~/Downloads

# Parallel download workers.
# BHOONIDHI_MCP_DOWNLOAD_PARALLEL=4

# Once a download's live byte total passes this many MB, download_status /
# download_wait flag it large and steer the agent to hand off to a watcher or
# run a standalone command instead of babysitting it.
# BHOONIDHI_MCP_LARGE_DOWNLOAD_MB=500

# --- Credentials (needed only for downloads and cart) ---
# Preferred: log in out of band with 'bhd auth login' — the server reuses that
# session and no credentials go here. These are an optional headless fallback;
# fill them out of band and never commit real values.
# BHOONIDHI_USERNAME=
# BHOONIDHI_PASSWORD=

